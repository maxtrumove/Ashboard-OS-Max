# Copy this file to ".env.local" and fill in your key, then run `npm run dev`.
# God Mode / Ashboard OS Max needs ONLY this one line to get live Gemini chat.
# (The app also accepts GEMINI_API_KEY or GOOGLE_API_KEY if you prefer those names.)

GOOGLE_GENERATIVE_AI_API_KEY=paste-your-gemini-key-here

# Everything below is OPTIONAL — only the legacy /graphs and /settings pages use a
# database. The God Mode command center and the Ash page do NOT need any of it.
# DATABASE_URL=
# DIRECT_URL=
# CREDENTIAL_SECRET=
