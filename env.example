# PostgreSQL connection (e.g. Supabase). Use the pooled connection for the app,
# and a direct/session connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# 32-byte (or longer) secret used to encrypt stored API credentials at rest.
# Generate one with: openssl rand -base64 32
CREDENTIAL_SECRET="change-me-to-a-long-random-string"

# Optional: fallback provider keys for local dev (the app prefers keys saved in Settings).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
